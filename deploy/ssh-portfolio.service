[Unit]
Description=Read-only SSH portfolio
Documentation=file:/opt/ssh-portfolio/SECURITY.md
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
DynamicUser=yes
# Provision this key as root before starting; the application gets a read-only copy.
LoadCredential=hostkey:/etc/ssh-portfolio/hostkey
# Loopback is intentional. Public exposure requires an explicit deployment decision.
ExecStart=/opt/ssh-portfolio/ssh-portfolio -listen 127.0.0.1:23234 -host-key %d/hostkey
WorkingDirectory=/
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
InaccessiblePaths=/tmp /var/tmp
PrivateIPC=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@mount @reboot @swap @privileged @resources @debug
SystemCallErrorNumber=EPERM
LimitCORE=0
LimitNOFILE=256
TasksMax=128
MemoryMax=256M
MemorySwapMax=0
CPUQuota=50%
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=50

[Install]
WantedBy=multi-user.target
